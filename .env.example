APP_NAME=FactoryShield AI
ENVIRONMENT=development
CORS_ORIGINS=
API_PORT=8000
FRONTEND_PORT=3000

# Docker Compose reads these. 
POSTGRES_USER=factoryshield
POSTGRES_PASSWORD=
POSTGRES_DB=factoryshield
POSTGRES_PORT=5440
# For running the API, scripts and tests on the host. Inside Docker Compose the API uses db:5432 instead.
DATABASE_URL=postgresql+asyncpg://factoryshield:<password>@localhost:5440/factoryshield
DATABASE_CONNECT_TIMEOUT=5

# At least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

SEED_SUPER_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# AI assistant provider: groq or openrouter. Only the chosen provider's key is needed.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Optional: replaces the built-in assistant system prompt
LLM_SYSTEM_PROMPT=

EMBEDDING_PORT=8091
# For the host.
EMBEDDING_BASE_URL=http://localhost:8091/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RAG_MIN_SCORE=0.80

# MCP stdio server
MCP_STDIO_USER_EMAIL=

# Production
PROD_DATABASE_URL=
# Hugging Face Space address
PROD_EMBEDDING_BASE_URL=
# Hugging Face access token
PROD_EMBEDDING_API_KEY=
# Demo account passwords
PROD_SEED_SUPER_ADMIN_PASSWORD=
PROD_SEED_ADMIN_PASSWORD=
PROD_SEED_STAFF_PASSWORD=
# Address of the Render service
PROD_API_BASE_URL=
