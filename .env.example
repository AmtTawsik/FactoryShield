APP_NAME=FactoryShield AI
ENVIRONMENT=development
# Host port of the API container (docker compose)
API_PORT=8000

# Docker Compose reads these. Use letters and digits in the password (it is also part of DATABASE_URL).
POSTGRES_USER=factoryshield
POSTGRES_PASSWORD=
POSTGRES_DB=factoryshield
POSTGRES_PORT=5440
# For running the API, scripts and tests on the host. Inside Docker Compose the API uses db:5432 instead.
DATABASE_URL=postgresql+asyncpg://factoryshield:<password>@localhost:5440/factoryshield
DATABASE_CONNECT_TIMEOUT=5

# At least 32 characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
# Optional: replaces the built-in assistant system prompt
LLM_SYSTEM_PROMPT=

EMBEDDING_PORT=8091
# For the host. Inside Docker Compose the API uses http://embeddings:80/v1 instead.
EMBEDDING_BASE_URL=http://localhost:8091/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
RAG_MIN_SCORE=0.80

# MCP stdio server (uv run python -m app.mcp.stdio) acts as this user
MCP_STDIO_USER_EMAIL=
